# Copy this file to .env and adjust as needed. .env is never committed.
POSTGRES_USER=recipes
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=recipes
DATABASE_URL=postgresql://recipes:devpassword@db:5432/recipes

# Auth secrets (Flask-Security-Too)
SECRET_KEY=change-me-to-a-long-random-string
SECURITY_PASSWORD_SALT=another-long-random-string

# Object storage (Cloudflare R2 — S3-compatible)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=recipe-photos
# The bucket's public URL (R2 → bucket → Settings → Public access → r2.dev URL).
# Browsers load photos from here; R2_ENDPOINT is the private upload API.
R2_PUBLIC_URL=https://pub-your-bucket-id.r2.dev

# Task queue broker (Redis)
REDIS_URL=redis://redis:6379/0
