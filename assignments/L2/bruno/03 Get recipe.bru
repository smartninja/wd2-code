meta {
  name: Get recipe
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/recipes/{{recipeId}}
  body: none
  auth: none
}

docs {
  Run "Create recipe" first: it sets {{recipeId}}.
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns the created recipe", function () {
    expect(res.getBody().id).to.equal(Number(bru.getVar("recipeId")));
  });
}
