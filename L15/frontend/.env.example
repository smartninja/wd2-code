# The base URL of the Flask API. Vite only exposes vars prefixed with VITE_.
# Copy this file to .env if you need to override the default (http://localhost:8000).
VITE_API_URL=http://localhost:8000
# On Render (Lesson 15) set it to the static site's OWN URL: the site's rewrite
# rules pass /api/*, /login and /logout through to the backend, so the browser
# sees one site and the session + XSRF-TOKEN cookies work.
